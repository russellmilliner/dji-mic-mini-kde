#!/usr/bin/env python3
"""
dji-mic - Linux CLI management & telemetry tool for DJI Mic Mini.
Configures settings, monitors battery and audio levels, and manages ALSA/PipeWire audio.
"""

from __future__ import annotations

import argparse
import json
import os
import socket
import sys
import time
from typing import Any, Dict, Optional

TRAY_SOCKET_PATH = f"/run/user/{os.getuid()}/dji-mic-tray.sock"


def query_tray_daemon(cmd: Dict[str, Any]) -> Optional[Dict[str, Any]]:
    if not os.path.exists(TRAY_SOCKET_PATH):
        return None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(2.5)
            s.connect(TRAY_SOCKET_PATH)
            s.sendall((json.dumps(cmd) + "\n").encode("utf-8"))
            chunks = []
            while True:
                data = s.recv(4096)
                if not data:
                    break
                chunks.append(data)
            return json.loads(b"".join(chunks).decode("utf-8"))
    except Exception:
        return None


def status_from_dict(d: Dict[str, Any]) -> DeviceStatus:
    from protocol import RxInfo, TxInfo

    st = DeviceStatus(
        connected=bool(d.get("connected", False)),
        dialect=str(d.get("dialect", "v1")),
        gain_dial_db=d.get("gain_dial_db"),
        nc_enabled=bool(d.get("nc_enabled", False)),
        settings=dict(d.get("settings") or {}),
        last_sequence=int(d.get("last_sequence") or 0),
        heartbeat_count=int(d.get("heartbeat_count") or 0),
        aux_5b05_hex=str(d.get("aux_5b05_hex") or ""),
        aux_0474_hex=str(d.get("aux_0474_hex") or ""),
        last_heartbeat_hex=str(d.get("last_heartbeat_hex") or ""),
        paired_tx_count_hid=d.get("paired_tx_count_hid"),
        active_tx_index_hid=d.get("active_tx_index_hid"),
    )
    if d.get("rx"):
        st.rx = RxInfo(**d["rx"])
    tx_raw = d.get("tx") or [None, None]
    st.tx = [TxInfo(**t) if t else None for t in tx_raw[:2]]
    while len(st.tx) < 2:
        st.tx.append(None)
    return st


def get_live_device_status(duration_s: float = 0.7) -> DeviceStatus:
    try:
        with DjiMicDevice() as dev:
            return dev.sync_status(duration_s)
    except DjiMicException as e:
        if "INTERFACE_BUSY" in str(e):
            resp = query_tray_daemon({"action": "status"})
            if resp and "duml" in resp:
                return status_from_dict(resp["duml"])
        raise

current_dir = os.path.dirname(os.path.realpath(__file__))
if current_dir not in sys.path:
