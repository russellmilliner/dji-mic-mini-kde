def render_dji_mic_pixmap(
    rx_connected: bool,
    tx_count: int,
    min_battery_pct: Optional[int],
    max_vu_level: int,
    muted: bool,
    size: int = 64,
) -> QPixmap:
    """Render a scalable high-contrast KDE system tray & task manager pixmap."""
    sz = 64
    pix = QPixmap(sz, sz)
    pix.fill(Qt.GlobalColor.transparent)

    p = QPainter(pix)
    p.setRenderHint(QPainter.RenderHint.Antialiasing, True)
    p.setRenderHint(QPainter.RenderHint.TextAntialiasing, True)

    if not rx_connected:
        primary_col = QColor("#ef4444")  # Red: USB Receiver unplugged
        badge_text = "OFF"
    elif tx_count == 0:
        primary_col = QColor("#f59e0b")  # Amber: Receiver plugged in, no TX linked
        badge_text = "NO TX"
    elif muted:
        primary_col = QColor("#ef4444")
        badge_text = "MUTE"
    else:
        pct = min_battery_pct if min_battery_pct is not None else 100
        if pct >= 40:
            primary_col = QColor("#22c55e")
        elif pct >= 20:
            primary_col = QColor("#f59e0b")
        else:
            primary_col = QColor("#ef4444")
        badge_text = f"{pct}%"

    # Live audio VU glow behind microphone capsule when speaking
    if rx_connected and tx_count > 0 and not muted and max_vu_level > 15:
        vu_alpha = min(180, int(40 + (max_vu_level / 120.0) * 140))
        glow_col = QColor(primary_col)
        glow_col.setAlpha(vu_alpha)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(glow_col)
        p.drawEllipse(QRectF(12, 4, 32, 38))

    # Microphone capsule body
    p.setPen(QPen(QColor("#0f172a"), 2.4))
    p.setBrush(QColor("#e2e8f0") if rx_connected else QColor("#64748b"))
    p.drawRoundedRect(QRectF(19, 7, 18, 28), 9, 9)

    # Microphone grille lines
    p.setPen(QPen(QColor("#334155"), 1.6))
    for y in (14, 19, 24):
        p.drawLine(23, y, 33, y)

    # Microphone U-cradle & stand
    cradle = QPainterPath()
    cradle.moveTo(14, 23)
    cradle.arcTo(QRectF(14, 11, 28, 28), 180, 180)
    p.setPen(QPen(primary_col, 3.2, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap))
    p.setBrush(Qt.BrushStyle.NoBrush)
    p.drawPath(cradle)

    p.drawLine(28, 39, 28, 49)
    p.drawLine(19, 49, 37, 49)

    # Top-left RX USB LED dot
    rx_led_col = QColor("#22c55e") if rx_connected else QColor("#ef4444")
    p.setPen(QPen(QColor("#0f172a"), 1.8))
    p.setBrush(rx_led_col)
    p.drawEllipse(QRectF(4, 5, 11, 11))

    # Top-right TX Wireless Link LED dot
    tx_led_col = (
        QColor("#22c55e")
        if (rx_connected and tx_count > 0)
        else (QColor("#f59e0b") if rx_connected else QColor("#475569"))
    )
    p.setBrush(tx_led_col)
    p.drawEllipse(QRectF(47, 5, 12, 12))

    # Bottom-right high-contrast status/battery badge
    bw = 44 if len(badge_text) >= 4 else 36
    bh = 20
    bx = sz - bw - 1
    by = sz - bh - 1
    p.setPen(QPen(QColor("#0f172a"), 2.0))
    p.setBrush(primary_col)
    p.drawRoundedRect(QRectF(bx, by, bw, bh), 6, 6)

    font = p.font()
    font.setPixelSize(11 if len(badge_text) <= 4 else 10)
    font.setBold(True)
    p.setFont(font)
    p.setPen(QColor("#0f172a"))
    p.drawText(QRect(bx, by, bw, bh), Qt.AlignmentFlag.AlignCenter, badge_text)

    p.end()
    if size != sz:
        return pix.scaled(
            size,
            size,
            Qt.AspectRatioMode.KeepAspectRatio,
            Qt.TransformationMode.SmoothTransformation,
        )
    return pix


def render_dji_mic_tray_icon(
    rx_connected: bool,
    tx_count: int,
    min_battery_pct: Optional[int],
    max_vu_level: int,
    muted: bool,
) -> QIcon:
    icon = QIcon()
    pix64 = render_dji_mic_pixmap(rx_connected, tx_count, min_battery_pct, max_vu_level, muted, 64)
    pix256 = render_dji_mic_pixmap(rx_connected, tx_count, min_battery_pct, max_vu_level, muted, 256)
    icon.addPixmap(pix64)
    icon.addPixmap(pix256)
    return icon


def ensure_task_manager_icon_files() -> None:
    """Export the rendered tray icon to assets/ and ~/.local/share/icons/hicolor/ so Wayland/KWin Task Manager uses it."""
    if os.path.exists("/.flatpak-info"):
        return
    try:
        pix64 = render_dji_mic_pixmap(True, 1, 100, 45, False, 64)
        pix256 = render_dji_mic_pixmap(True, 1, 100, 45, False, 256)
        for path, pix in (
            (APP_ICON_PATH, pix256),
            (HICOLOR_256_PATH, pix256),
            (HICOLOR_64_PATH, pix64),
        ):
            try:
                path.parent.mkdir(parents=True, exist_ok=True)
                pix.save(str(path), "PNG")
            except Exception:
                pass
    except Exception:
        pass


class PloopyAndZoomEventFilter(QObject):
    """
    Global QApplication event filter implementing Rule 7.2 & Rule 7.4:
      - Standard zoom hotkeys (Ctrl++, Ctrl+=, Ctrl+-, Ctrl+_, Ctrl+0, Ctrl+),
        numpad Ctrl+KP_Add/Subtract/0, and Ctrl+Wheel zoom)
      - HiDPI / Ploopy high-resolution wheel scrolling (linear angleDelta.y() * 0.50,
        zero deadzone, 350ms target lock on deepest scrollable Flickable, and
        hover/tooltip suppression during active wheel scrolling)
    """

    def __init__(self, controller: "DjiMicController") -> None:
        super().__init__(controller)
        self.controller = controller
        self._locked_flickable: Optional[QQuickItem] = None
        self._last_wheel_ms: float = 0.0
        self._scrolling_active: bool = False
        self._hover_restore_timer = QTimer(self)
        self._hover_restore_timer.setSingleShot(True)
        self._hover_restore_timer.setInterval(400)
        self._hover_restore_timer.timeout.connect(self._restore_hover)

    def _restore_hover(self) -> None:
        self._scrolling_active = False
        self._locked_flickable = None

    @staticmethod
    def _is_scrollable_flickable(item: QQuickItem) -> bool:
        meta = item.metaObject()
        cls_name = meta.className() if meta else ""
        if not any(k in cls_name for k in ("Flickable", "ListView", "GridView", "ScrollView")):
            return False
        try:
            ch = float(item.property("contentHeight") or 0.0)
            h = float(item.height())
            return ch > h + 1.0
        except Exception:
            return False

    def _find_deepest_flickable(self, root_item: Optional[QQuickItem], scene_pos: QPointF) -> Optional[QQuickItem]:
        if root_item is None or not root_item.isVisible():
            return None
        best: Optional[QQuickItem] = None

        def walk(item: QQuickItem) -> None:
            nonlocal best
            if not item.isVisible() or item.opacity() <= 0.0:
                return
            pt = item.mapFromScene(scene_pos)
            if 0.0 <= pt.x() <= item.width() and 0.0 <= pt.y() <= item.height():
                if self._is_scrollable_flickable(item):
                    best = item
                for child in item.childItems():
                    walk(child)

        walk(root_item)
        return best

    def eventFilter(self, obj: QObject, event: QEvent) -> bool:
        etype = event.type()

        if self._scrolling_active and etype in (
            QEvent.Type.HoverEnter,
            QEvent.Type.HoverMove,
            QEvent.Type.ToolTip,
        ):
            return True

        if etype == QEvent.Type.MouseMove and self._scrolling_active:
            self._restore_hover()

        if etype == QEvent.Type.KeyPress and isinstance(obj, QQuickWindow):
            mods = event.modifiers()
            if mods & Qt.KeyboardModifier.ControlModifier:
                key = event.key()
                text = event.text()
                if key in (Qt.Key.Key_Plus, Qt.Key.Key_Equal) or text in ("+", "="):
                    self.controller.zoomIn()
                    return True
                if key in (Qt.Key.Key_Minus, Qt.Key.Key_Underscore) or text in ("-", "_"):
                    self.controller.zoomOut()
                    return True
                if key in (Qt.Key.Key_0, Qt.Key.Key_ParenRight) or text in ("0", ")"):
                    self.controller.zoomReset()
                    return True

        if etype == QEvent.Type.Wheel and isinstance(obj, QQuickWindow):
            mods = event.modifiers()
            angle = event.angleDelta()
            pixel = event.pixelDelta()
            if mods & Qt.KeyboardModifier.ControlModifier:
                dy = angle.y() if not angle.isNull() else pixel.y()
                if dy > 0:
                    self.controller.zoomIn()
                elif dy < 0:
                    self.controller.zoomOut()
                return True

            dy_px = 0.0
            if not angle.isNull() and angle.y() != 0:
                dy_px = angle.y() * 0.50
            elif not pixel.isNull() and pixel.y() != 0:
                dy_px = float(pixel.y())

            if abs(dy_px) > 0.01:
                now_ms = time.monotonic() * 1000.0
                scene_pos = event.position()
                flick = None
                if (
                    self._locked_flickable is not None
                    and (now_ms - self._last_wheel_ms) <= 350.0
                    and self._locked_flickable.isVisible()
                ):
                    flick = self._locked_flickable
                if flick is None:
                    flick = self._find_deepest_flickable(obj.contentItem(), scene_pos)
                    self._locked_flickable = flick

                self._last_wheel_ms = now_ms
                if flick is not None:
                    self._scrolling_active = True
                    self._hover_restore_timer.start()
                    try:
                        cur_y = float(flick.property("contentY") or 0.0)
                        orig_y = float(flick.property("originY") or 0.0)
                        top_m = float(flick.property("topMargin") or 0.0)
                        bot_m = float(flick.property("bottomMargin") or 0.0)
                        ch = float(flick.property("contentHeight") or 0.0)
                        h = float(flick.height())
                        min_y = orig_y - top_m
                        max_y = max(min_y, orig_y + ch + bot_m - h)
                        new_y = max(min_y, min(max_y, cur_y - dy_px))
                        flick.setProperty("contentY", new_y)
                        event.accept()
                        return True
                    except Exception:
                        pass

        return super().eventFilter(obj, event)


class DjiMicController(QObject):
    stateChanged = pyqtSignal()
    windowChanged = pyqtSignal()
    configChanged = pyqtSignal()

    def __init__(self, start_minimized: bool = False, ui_test_mode: bool = False) -> None:
        super().__init__()
        self._ui_test_mode = ui_test_mode
        self._quitting = False
        self._window_visible = not start_minimized
        self._active_tab_index = 0
        self._last_action_message = ""
        self._event_log: List[str] = []

        self._config: Dict[str, Any] = {
            "ui_zoom_percent": 100,
            "color_scheme": "system",
            "alert_on_rx_disconnect": True,
            "alert_on_tx_disconnect": True,
            "alert_on_low_battery": True,
            "low_battery_threshold_pct": 25,
        }
        self._load_config()

        self._dev: Optional[DjiMicDevice] = None
        self._usb_info = UsbSysfsInfo()
        self._udev_status = UdevStatus()
        self._status = DeviceStatus()
        self._alsa_card: Dict[str, Any] = {}
        self._alsa_vol: Dict[str, Any] = {"percent": 100, "db": "0.00dB", "muted": False}
        self._pw_info: Dict[str, Any] = {}
        self._last_slow_poll: float = 0.0

        self._initial_check_done = False
        self._prev_rx_connected: Optional[bool] = None
        self._prev_tx_count: Optional[int] = None
        self._low_bat_alerted: Dict[int, bool] = {1: False, 2: False}

        self._tray: Optional[QSystemTrayIcon] = None
        self._tray_menu: Optional[QMenu] = None
        self._last_tray_sig: Any = None

        if not self._ui_test_mode:
            ensure_task_manager_icon_files()
            self._setup_tray()
            self._start_socket_server()

        self._poll_timer = QTimer(self)
        self._poll_timer.setInterval(250)
        self._poll_timer.timeout.connect(self._poll_tick)
        if not self._ui_test_mode:
            self._poll_tick()
            self._poll_timer.start()

    def _load_config(self) -> None:
        try:
            if CONFIG_PATH.exists():
                data = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
                if isinstance(data, dict):
                    self._config.update(data)
        except Exception:
            pass
        self._config["ui_zoom_percent"] = max(75, min(175, int(self._config.get("ui_zoom_percent", 100))))

    def _save_config(self) -> None:
        if self._ui_test_mode:
            return
        try:
            CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
            old_umask = os.umask(0o177)
            try:
                CONFIG_PATH.write_text(json.dumps(self._config, indent=2), encoding="utf-8")
            finally:
                os.umask(old_umask)
            os.chmod(CONFIG_PATH, 0o600)
        except Exception:
            pass

    def _log_event(self, msg: str) -> None:
        ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        line = f"[{ts}] {msg}"
        self._event_log.insert(0, line)
        del self._event_log[40:]

    def _send_desktop_popup(self, title: str, body: str, urgency: str = "critical") -> None:
        self._log_event(f"{title}: {body}")
        if self._ui_test_mode:
            return
        icon_arg = str(APP_ICON_PATH) if APP_ICON_PATH.exists() else "audio-input-microphone"
        if shutil.which("notify-send"):
            try:
                subprocess.Popen(
                    [
                        "notify-send",
                        "-u",
                        urgency,
                        "-a",
                        "KDE DJI Mic Mini Control",
                        "-i",
                        icon_arg,
                        title,
                        body,
                    ],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    shell=False,
                )
                return
            except Exception:
                pass
        if self._tray:
            icon_type = (
                QSystemTrayIcon.MessageIcon.Critical
                if urgency == "critical"
                else QSystemTrayIcon.MessageIcon.Information
            )
            self._tray.showMessage(title, body, icon_type, 8000)

    def _poll_tick(self) -> None:
        now = time.monotonic()
        slow_due = (now - self._last_slow_poll) >= 2.5

        if slow_due:
            self._last_slow_poll = now
            self._usb_info = get_usb_sysfs_info()
            self._udev_status = check_udev_status(self._usb_info)
            self._alsa_card = audio.get_alsa_card_info()
            vol = audio.get_alsa_volume()
            if vol:
                self._alsa_vol = vol
            self._pw_info = audio.get_pipewire_stream_details()

        if not self._usb_info.present:
            if self._dev is not None:
                self._dev.close()
                self._dev = None
            self._status = DeviceStatus(connected=False)
        else:
            if self._dev is None or not self._dev.is_open():
                try:
                    self._dev = DjiMicDevice()
                    self._dev.open()
                    if self._usb_info.hidraw_node:
                        hid_info = query_hid_service_info(self._usb_info.hidraw_node)
                        self._dev.status.paired_tx_count_hid = hid_info.get("paired_tx_count")
                        self._dev.status.active_tx_index_hid = hid_info.get("active_tx_index")
                except Exception:
                    if self._dev:
                        self._dev.close()
                    self._dev = None
                    self._status = DeviceStatus(connected=False)

            if self._dev is not None and self._dev.is_open():
                try:
                    for _ in range(3):
                        frames = self._dev.poll_frames(timeout_ms=15)
                        if not frames:
                            break
                    self._status = self._dev.status
                except DjiMicNotFoundError:
                    self._dev.close()
                    self._dev = None
                    self._usb_info = get_usb_sysfs_info()
                    self._udev_status = check_udev_status(self._usb_info)
                    self._status = DeviceStatus(connected=False)
                except Exception:
                    pass

        self._evaluate_alerts()
        self._write_runtime_status()
        self._update_tray_ui()
        self.stateChanged.emit()

    def _evaluate_alerts(self) -> None:
        rx_ok = bool(self._usb_info.present and self._status.connected)
        tx_cnt = self._status.tx_count() if rx_ok else 0

        if self._usb_info.present and not self._status.connected:
            return

        if not self._initial_check_done:
            self._initial_check_done = True
            self._prev_rx_connected = rx_ok
            self._prev_tx_count = tx_cnt
            if not rx_ok and self._config.get("alert_on_rx_disconnect", True):
                self._send_desktop_popup(
                    "DJI Mic Mini Disconnected",
                    "The DJI Mic Mini USB-C Receiver (2ca3:4011) is not connected to this PC.",
                    urgency="critical",
                )
            elif rx_ok and tx_cnt == 0 and self._config.get("alert_on_tx_disconnect", True):
                self._send_desktop_popup(
                    "DJI Mic Mini Transmitter Disconnected",
                    "The USB-C Receiver is plugged in, but no wireless microphone transmitter (TX1/TX2) is powered on or linked.",
                    urgency="critical",
                )
            else:
                self._log_event(
                    f"Monitoring started — Receiver connected, {tx_cnt} transmitter(s) active."
                )
            return

        if self._prev_rx_connected is True and not rx_ok:
            if self._config.get("alert_on_rx_disconnect", True):
                self._send_desktop_popup(
                    "DJI Mic Mini USB Receiver Disconnected",
                    "The DJI Mic Mini USB-C Receiver (2ca3:4011) was unplugged.",
                    urgency="critical",
                )
        elif self._prev_rx_connected is False and rx_ok:
            self._send_desktop_popup(
                "DJI Mic Mini Receiver Connected",
                f"USB-C Receiver (S/N {self.rxSerial}) connected ({tx_cnt} transmitter(s) linked).",
                urgency="normal",
            )

        if rx_ok and self._prev_rx_connected is True:
            if (self._prev_tx_count or 0) > 0 and tx_cnt == 0:
                if self._config.get("alert_on_tx_disconnect", True):
                    self._send_desktop_popup(
                        "DJI Mic Mini Transmitter Disconnected",
                        "All DJI Mic Mini wireless transmitters (TX1/TX2) powered off or lost link.",
                        urgency="critical",
                    )
            elif (self._prev_tx_count or 0) == 0 and tx_cnt > 0:
                tx_summary = []
                for t in self._status.tx:
                    if t and t.connected:
                        tx_summary.append(f"TX{t.unit}: {t.battery_percent or 100}%")
                self._send_desktop_popup(
                    "DJI Mic Mini Transmitter Connected",
                    f"Wireless link active ({', '.join(tx_summary)}).",
                    urgency="normal",
                )

        if rx_ok and self._config.get("alert_on_low_battery", True):
            thresh = int(self._config.get("low_battery_threshold_pct", 25))
            for t in self._status.tx:
                if t and t.connected and t.battery_percent is not None:
                    if t.battery_percent <= thresh and not self._low_bat_alerted.get(t.unit, False):
                        self._low_bat_alerted[t.unit] = True
                        self._send_desktop_popup(
                            f"DJI Mic Mini TX{t.unit} Low Battery ({t.battery_percent}%)",
                            f"Transmitter TX{t.unit} (S/N {t.serial}) battery is at {t.battery_percent}% (gauge {t.battery}/7).",
                            urgency="critical",
                        )
                    elif t.battery_percent > thresh:
                        self._low_bat_alerted[t.unit] = False

        self._prev_rx_connected = rx_ok
        self._prev_tx_count = tx_cnt

    def _write_runtime_status(self) -> None:
        if self._ui_test_mode:
            return
        try:
            old_umask = os.umask(0o177)
            try:
                STATUS_JSON_PATH.write_text(
                    json.dumps(self.build_full_snapshot(), indent=2),
                    encoding="utf-8",
                )
            finally:
                os.umask(old_umask)
            os.chmod(STATUS_JSON_PATH, 0o600)
        except Exception:
            pass

    def build_full_snapshot(self) -> Dict[str, Any]:
        return {
            "usb": self._usb_info.to_dict(),
            "udev": self._udev_status.to_dict(),
            "duml": self._status.to_dict(),
            "audio": {
                "alsa_card": self._alsa_card,
                "volume": self._alsa_vol,
                "pipewire": self._pw_info,
            },
        }

    # ------------------------------------------------------------------
    # System Tray Icon & Context Menu + Task Manager Window Icon Sync
    # ------------------------------------------------------------------
    def _setup_tray(self) -> None:
        self._tray = QSystemTrayIcon(self)
        self._tray_menu = QMenu()
        self._tray.setContextMenu(self._tray_menu)
        self._tray.activated.connect(self._on_tray_activated)
        self._update_tray_ui(force=True)
        self._tray.show()

    def _on_tray_activated(self, reason: QSystemTrayIcon.ActivationReason) -> None:
        if reason in (
            QSystemTrayIcon.ActivationReason.Trigger,
            QSystemTrayIcon.ActivationReason.DoubleClick,
        ):
            self.toggleWindow()

    def _sync_window_and_taskbar_icon(self, icon: QIcon) -> None:
        """Apply the tray icon as the application & window icon for the KDE Task Manager."""
        app = QApplication.instance()
        if isinstance(app, QApplication):
            app.setWindowIcon(icon)
        for w in QGuiApplication.topLevelWindows():
            w.setIcon(icon)

    def _update_tray_ui(self, force: bool = False) -> None:
        if not self._tray or not self._tray_menu:
            return

        rx_ok = self.rxConnected
        tx_cnt = self.txConnectedCount
        bats = [t.battery_percent for t in self._status.tx if t and t.connected and t.battery_percent is not None]
        min_bat = min(bats) if bats else None
        vus = [t.level or 0 for t in self._status.tx if t and t.connected]
        max_vu = max(vus) if vus else 0
        vu_bucket = int(max_vu // 20)
        muted = self.alsaMuted

        sig = (
            rx_ok,
            tx_cnt,
            min_bat,
            vu_bucket,
            muted,
            self._udev_status.ready,
            dict(self._status.settings),
            self._alsa_vol.get("percent"),
            self._config.get("alert_on_rx_disconnect"),
            self._config.get("alert_on_tx_disconnect"),
            self._config.get("alert_on_low_battery"),
        )
        if not force and sig == self._last_tray_sig:
            return
        self._last_tray_sig = sig

        icon = render_dji_mic_tray_icon(rx_ok, tx_cnt, min_bat, max_vu, muted)
