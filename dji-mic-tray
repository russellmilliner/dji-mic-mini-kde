    # ------------------------------------------------------------------
    # Hardened Local Unix Socket Server (0600 + SO_PEERCRED UID verification)
    # ------------------------------------------------------------------
    def _start_socket_server(self) -> None:
        try:
            if SOCKET_PATH.exists():
                SOCKET_PATH.unlink()
        except Exception:
            pass

        def serve() -> None:
            srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            try:
                old_umask = os.umask(0o177)
                try:
                    srv.bind(str(SOCKET_PATH))
                finally:
                    os.umask(old_umask)
                os.chmod(str(SOCKET_PATH), 0o600)
                srv.listen(5)
                my_uid = os.getuid()
                while not self._quitting:
                    try:
                        conn, _ = srv.accept()
                    except Exception:
                        break
                    with conn:
                        try:
                            # Verify SO_PEERCRED UID matches our user
                            creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12)
                            _, peer_uid, _ = struct.unpack("3i", creds)
                            if peer_uid != my_uid:
                                conn.sendall(b'{"ok":false,"error":"Unauthorized peer UID"}')
                                continue

                            raw = conn.recv(4096).decode("utf-8", errors="replace").strip()
                            req = json.loads(raw) if raw else {}
                            act = req.get("action")
                            if act == "status":
                                resp = self.build_full_snapshot()
                            elif act == "show":
                                QTimer.singleShot(0, lambda: self.setWindowVisible(True))
                                resp = {"ok": True}
                            elif act == "toggle":
                                QTimer.singleShot(0, self.toggleWindow)
                                resp = {"ok": True}
                            elif act == "set":
                                setting = str(req.get("setting", ""))
                                value = str(req.get("value", "on"))
                                tx_u = req.get("tx")
                                ok = self._apply_setting_sync(setting, value, tx_u)
                                resp = {"ok": ok}
                            else:
                                resp = {"error": f"Unknown action: {act}"}
                        except Exception as e:
                            resp = {"ok": False, "error": str(e)}
                        try:
                            conn.sendall(json.dumps(resp).encode("utf-8"))
                        except Exception:
                            pass
            finally:
                try:
                    srv.close()
                except Exception:
                    pass

        t = threading.Thread(target=serve, daemon=True)
        t.start()

    def _apply_setting_sync(self, setting: str, value: str, tx_unit: Optional[int] = None) -> bool:
        if setting not in SETTINGS_SPEC:
            raise ValueError(f"Setting '{setting}' is not in the verified allowlist.")
        if not self._dev or not self._dev.is_open():
            raise DjiMicNotFoundError("DJI Mic Mini Receiver is not connected.")
        ok = self._dev.set_setting(setting, value, tx_unit=tx_unit)
        self._status = self._dev.status
        self._last_action_message = f"Applied {setting} = {value}"
        self._log_event(f"Hardware setting updated: {setting} -> {value}")
        self.stateChanged.emit()
        return ok or (self._status.settings.get(setting) == value)

