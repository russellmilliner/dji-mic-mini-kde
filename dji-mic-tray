        aux_5b05_hex="0000000004000d000101",
        aux_0474_hex="04",
    )

    engine = QQmlApplicationEngine()
    engine.rootContext().setContextProperty("controller", controller)
    engine.load(QUrl.fromLocalFile(str(QML_PATH)))
    if not engine.rootObjects():
        print("UI_TEST_FAILED: QML failed to load", file=sys.stderr)
        return 1

    win = engine.rootObjects()[0]
    assert isinstance(win, QQuickWindow)
    ev_filter = PloopyAndZoomEventFilter(controller)
    app.installEventFilter(ev_filter)

    violations: List[str] = []

    def check_tree(item: QQuickItem, context_label: str, check_tabbar_fit: bool = False) -> None:
        if not item.isVisible() or item.opacity() <= 0.0 or item.width() <= 0 or item.height() <= 0:
            return
        cls_name = item.metaObject().className() if item.metaObject() else ""
        if check_tabbar_fit and item.objectName() == "mainTabBar":
            try:
                ci = item.property("contentItem")
                cw = float(ci.property("contentWidth") if ci else item.implicitWidth())
                tw = float(item.width())
                if cw > tw + 2.0:
                    violations.append(
                        f"{context_label}: TabBar overflow — tabs require {cw:.1f}px but TabBar width is {tw:.1f}px"
                    )
            except Exception:
                pass
        if "Text" in cls_name or "Label" in cls_name or "Heading" in cls_name:
            try:
                truncated = bool(item.property("truncated"))
                cw = float(item.property("contentWidth") or 0.0)
                ch = float(item.property("contentHeight") or 0.0)
                w = float(item.width())
                h = float(item.height())
                txt = str(item.property("text") or "")[:40]
                if not truncated and cw > w + 4.0:
                    violations.append(f"{context_label}: Horizontal text overflow ({cw:.1f} > {w:.1f}) on '{txt}'")
                if not truncated and ch > h + 6.0:
                    violations.append(f"{context_label}: Vertical text overflow ({ch:.1f} > {h:.1f}) on '{txt}'")
            except Exception:
                pass
        for child in item.childItems():
            check_tree(child, context_label, check_tabbar_fit)

    # First verify default initial window width fits all 5 tabs at 100% zoom
    app.processEvents()
    tb_item = win.findChild(QObject, "mainTabBar")
    if tb_item is not None:
        ci = tb_item.property("contentItem")
        cw = float(ci.property("contentWidth") if ci else tb_item.property("implicitWidth"))
        tw = float(tb_item.property("width"))
        if cw > tw + 2.0:
            violations.append(
                f"Default window width ({win.width()}px) is too narrow for all 5 tabs ({cw:.1f}px > {tw:.1f}px)"
            )

    for w_sz, h_sz in ((760, 540), (1220, 780), (1360, 860)):
        win.setWidth(w_sz)
        win.setHeight(h_sz)
        for scheme in ("dark", "light"):
            controller.setColorScheme(scheme)
            for zoom in (80, 100, 130):
                controller.setUiZoomPercent(zoom)
                for tab_idx in range(5):
                    controller.setActiveTabIndex(tab_idx)
                    app.processEvents()
                    content = win.contentItem()
                    if content:
                        check_tree(
                            content,
                            f"{w_sz}x{h_sz} scheme={scheme} zoom={zoom}% tab={tab_idx}",
                            check_tabbar_fit=(w_sz >= 1220 and zoom <= 100),
                        )

    if violations:
        print("UI_TEST_FAILED:\n" + "\n".join(violations[:25]), file=sys.stderr)
        return 1

    print(
        "UI_TEST_OK: 0 layout, TabBar, or text overflow violations across all window sizes (760x540, 1220x780, 1360x860), Dark/Light themes, zoom levels (80%, 100%, 130%), and all 5 tabs (including About & udev)."
    )
    return 0


def send_socket_command(cmd: Dict[str, Any]) -> Optional[Dict[str, Any]]:
    if not SOCKET_PATH.exists():
        return None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(1.5)
            s.connect(str(SOCKET_PATH))
            s.sendall((json.dumps(cmd) + "\n").encode("utf-8"))
            data = s.recv(65536)
            return json.loads(data.decode("utf-8")) if data else None
    except Exception:
        return None


def main() -> None:
    parser = argparse.ArgumentParser(
        description="KDE DJI Mic Mini Control — KDE Plasma 6 System Tray & Telemetry"
    )
    parser.add_argument(
        "--minimized",
        action="store_true",
        help="Start minimized in the KDE system tray without opening the dashboard window",
    )
    parser.add_argument(
        "--show",
        action="store_true",
        help="Show the dashboard window of an already-running tray instance",
    )
    parser.add_argument(
        "--toggle",
        action="store_true",
        help="Toggle the dashboard window of an already-running tray instance",
    )
    parser.add_argument(
        "--status",
        action="store_true",
        help="Print current status JSON from running instance or direct USB query",
    )
    parser.add_argument(
        "--ui-test",
        action="store_true",
        help="Run headless KDE Plasma 6 QML layout & geometry overflow verification",
    )
    args = parser.parse_args()

    if args.ui_test:
        sys.exit(run_ui_overflow_tests())

    if args.status:
        resp = send_socket_command({"action": "status"})
        if resp:
            print(json.dumps(resp, indent=2))
            sys.exit(0)
        os.execv(str(Path(current_dir) / "dji-mic"), ["dji-mic", "status", "--json"])

    if args.show:
        resp = send_socket_command({"action": "show"})
        if resp:
            sys.exit(0)

    if args.toggle:
        resp = send_socket_command({"action": "toggle"})
        if resp:
            sys.exit(0)

    existing = send_socket_command({"action": "status"})
    if existing is not None:
        if not args.minimized:
            send_socket_command({"action": "show"})
        sys.exit(0)

    app = QApplication(sys.argv)
    app.setApplicationName("KDE DJI Mic Mini Control")
    app.setApplicationDisplayName("KDE DJI Mic Mini Control")
    app.setOrganizationName("millinr")
    if os.path.exists("/.flatpak-info"):
        QGuiApplication.setDesktopFileName("io.github.russellmilliner.DjiMicMiniControl")
    else:
        QGuiApplication.setDesktopFileName("dji-mic-tray")
    app.setQuitOnLastWindowClosed(False)

    ensure_task_manager_icon_files()
    initial_icon = render_dji_mic_tray_icon(True, 1, 100, 0, False)
    app.setWindowIcon(initial_icon)

    controller = DjiMicController(start_minimized=args.minimized, ui_test_mode=False)

    engine = QQmlApplicationEngine()
    engine.rootContext().setContextProperty("controller", controller)
    engine.load(QUrl.fromLocalFile(str(QML_PATH)))
    if not engine.rootObjects():
        sys.exit(1)

    win = engine.rootObjects()[0]
    if isinstance(win, QQuickWindow):
        win.setIcon(controller._tray.icon() if controller._tray else initial_icon)

    ev_filter = PloopyAndZoomEventFilter(controller)
    app.installEventFilter(ev_filter)

    sys.exit(app.exec())


if __name__ == "__main__":
    main()
