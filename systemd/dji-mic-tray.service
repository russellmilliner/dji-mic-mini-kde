[Unit]
Description=KDE DJI Mic Mini Control (Rust) — System Tray Telemetry, Hardware Controller & Disconnection Alert Monitor
After=graphical-session.target pipewire.service wireplumber.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/dji-mic-tray --minimized
Restart=on-failure
RestartSec=3
Environment=QT_QUICK_CONTROLS_STYLE=org.kde.desktop

[Install]
WantedBy=default.target
